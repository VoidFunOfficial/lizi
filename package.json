{
  "name": "njust-campus-map",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "basemap:guide": "node scripts/generate-georectified-guide.mjs",
    "basemap:guide:visual-only": "node scripts/generate-refined-guide.mjs",
    "basemap:vector": "node scripts/generate-precise-basemap.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:android:web": "NJUST_ANDROID_BUILD=1 vinext build",
    "android": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs release",
    "android:bundle": "node scripts/build-android.mjs bundle",
    "build:ios:web": "NJUST_IOS_BUILD=1 vinext build",
    "ios": "node scripts/build-ios.mjs",
    "ios:open": "node scripts/build-ios.mjs open",
    "ios:device": "node scripts/build-ios.mjs device",
    "test:ios": "node scripts/test-ios-services.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "oxlint app lib tests",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm lint && pnpm typecheck",
    "version:check": "node scripts/app-version.mjs",
    "test:release": "node --experimental-strip-types --test tests/release-version.test.ts",
    "release:version": "node scripts/bump-version.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "vercel:package": "node scripts/prepare-vercel.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "suncalc": "2.0.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "esbuild": "0.27.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
